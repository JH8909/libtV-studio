{
  "name": "libtv-studio-complete",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @libtv/web --filter @libtv/api --filter @libtv/worker dev",
    "dev:web": "pnpm --filter @libtv/web dev",
    "dev:backend": "pnpm --parallel --filter @libtv/api --filter @libtv/worker dev",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @libtv/db db:push",
    "validate:source": "python3 scripts/validate-source.py",
    "standalone": "node standalone/server.mjs",
    "test:agnes": "node standalone/agnes-provider-e2e.mjs",
    "test:generation-reliability": "node standalone/generation-reliability-e2e.mjs",
    "test:providers": "node standalone/provider-contract-e2e.mjs",
    "test:creative-agent": "node standalone/creative-agent-e2e.mjs",
    "test:keyboard": "node standalone/keyboard-shortcuts-e2e.mjs",
    "test:canvas": "node standalone/canvas-interactions-e2e.mjs",
    "test:image-presets": "node standalone/image-presets-e2e.mjs",
    "test:design-system": "node standalone/design-system-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@tabler/icons": "3.36.0"
  }
}
