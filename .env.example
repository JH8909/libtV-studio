# Core
DATABASE_URL=postgres://libtv:libtv@localhost:5432/libtv
REDIS_URL=redis://localhost:6379
API_PORT=3001

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=libtv-assets
S3_ACCESS_KEY=libtv
S3_SECRET_KEY=libtvsecret
S3_PUBLIC_BASE_URL=http://localhost:9000/libtv-assets
S3_FORCE_PATH_STYLE=true

# Worker
GENERATION_POLL_INTERVAL_MS=1000
GENERATION_MAX_POLLS=120
ENABLE_MOCK_PROVIDER=true
# When worker runs from apps/worker this resolves to repo-root/fixtures.
MOCK_FIXTURE_DIR=../../fixtures

# Real provider adapters - wire these to official APIs in the next integration step.
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
VOLCENGINE_IMAGE_MODEL=
VOLCENGINE_VIDEO_MODEL=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=
KLING_VIDEO_MODEL=
# Standalone real providers (used by `node standalone/server.mjs`)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_TEXT_MODEL=gpt-5-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AGENT_MODEL=gpt-5-mini
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_AGENT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/qwen-image
FAL_VIDEO_MODEL=fal-ai/wan/v2.7/text-to-video
FAL_VIDEO_IMAGE_MODEL=fal-ai/wan/v2.7/image-to-video
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_VIDEO_MODEL=kling-v3
GEMINI_API_KEY=
GEMINI_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT_MODEL=gemini-2.5-flash
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
