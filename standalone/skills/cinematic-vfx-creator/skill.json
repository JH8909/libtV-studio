  "inputs": [
    {
      "id": "instruction",
      "label": "创作描述",
      "type": "text",
      "required": true,
      "placeholder": "例如：黑色战甲角色在雨夜释放雷电，与火焰碰撞，镜头快速推进"
    },
    {
      "id": "referenceAsset",
      "label": "参考素材",
      "type": "asset",
      "required": false,
      "accept": [
        "image",
        "video"
      ]
    },
    {
      "id": "durationSec",
      "label": "目标时长",
      "type": "select",
      "required": true,
      "default": 15,
      "options": [
        15,
        30
      ]
    },
    {
      "id": "aspectRatio",
      "label": "画幅",
      "type": "select",
      "required": true,
      "default": "9:16",
      "options": [
        "9:16",
        "16:9"
      ]
    }
  ],
  "outputs": [
    "动作与特效拆解方案",
    "一段影视打斗特效视频",
    "自动加入 Timeline 的视频成片草稿"
  ],
  "fixedSteps": [
    "从一句话提取角色、动作、特效类型、情绪和场景约束",
    "明确风、火、雷、电等特效组合及其与角色动作的对应关系",
    "有参考图或视频时锁定人物、服装、动作方向和场景光线",
    "按目标画幅与时长生成影视打斗特效视频",
    "将成功的视频结果自动加入 Timeline"
  ],
  "rules": {
    "format": "9:16 / 16:9",
    "durationSec": 15,
    "durationOptions": [
      15,
      30
    ],
    "shotCount": 1,
    "shotDurationSec": 15,
    "visual": "角色动作清晰，特效有明确触发关系，避免无意义粒子堆叠",
    "continuity": "参考图或视频优先锁定角色身份、服装、动作方向和场景光线",
    "safety": "不新增无指令角色，不改变主体身份，不出现随机变脸、换装、肢体穿模和无指令切镜"
  },
  "promptTemplates": {
    "vfxPlanSystem": "你是影视动作指导和特效总监。把用户一句话拆成角色、动作、特效触发、镜头、场景、情绪与连续性约束，输出简洁可执行的生成计划。不要新增未指定的人物或剧情。",
    "vfxPlanPrompt": "请拆解以下影视打斗特效需求：{{INSTRUCTION}}。输出：角色与服装、动作链、特效类型与触发点、场景与光线、镜头运动、连续性约束、负面约束。",
    "vfxVideoPrompt": "影视打斗特效视频生成指令：{{INSTRUCTION}}。角色动作必须清晰可追踪，特效在动作触发点出现并服从物理方向；保持角色身份、服装、场景和镜头连续。支持风火雷电等元素组合，但不得无意义堆叠粒子；不得随机增加角色、变脸、换装、肢体变形、穿模、无指令切镜或画面文字。目标时长 {{DURATION_SEC}} 秒，画幅 {{ASPECT_RATIO}}。"
  },
