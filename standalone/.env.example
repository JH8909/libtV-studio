# LibTV Studio Standalone v2.0
# Copy to standalone/.env. The server also supports configuring these from the in-app “模型/API” panel.
PORT=3000
HOST=127.0.0.1

# ---------- Agnes AI: text + image + video ----------
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_AGENT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_VIDEO_TIMEOUT_MS=1200000

# ---------- APIMart: text + image + video + Agent ----------
# Official docs: https://docs.apimart.ai/llms.txt
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_CHAT_BASE_URL=https://api.apimart.ai/api/v1
APIMART_TIMEOUT_MS=1200000

# ---------- DeepSeek: text + Agent ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro

# ---------- Alibaba Cloud Bailian / DashScope: text + Agent ----------
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MEDIA_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_AGENT_MODEL=qwen-plus
BAILIAN_IMAGE_MODEL=qwen-image-2.0
BAILIAN_VIDEO_MODEL=wan2.7-t2v-2026-06-12

# ---------- References / local media ----------
# If a provider requires a public URL rather than inline media, point this to a tunnel/reverse proxy for this Studio.
PUBLIC_BASE_URL=
EXTERNAL_REFERENCE_MODE=data-uri

# ---------- Media / export ----------
MAX_UPLOAD_BYTES=536870912
MAX_REMOTE_BYTES=1073741824
# Optional. Auto-detected with fontconfig when blank.
FFMPEG_FONT_FILE=
