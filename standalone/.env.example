# LibTV Studio Standalone v2.0
# Copy to standalone/.env. The server also supports configuring these from the in-app “模型/API” panel.
PORT=3000
HOST=127.0.0.1

# ---------- Text: OpenAI-compatible Chat Completions ----------
# Works with OpenAI-compatible /chat/completions endpoints.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_TEXT_MODEL=gpt-5-mini

# ---------- Creative planning Agent ----------
# OpenAI uses the native Responses API. OPENAI_API_KEY may be omitted when the compatible key above is an OpenAI key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AGENT_MODEL=gpt-5-mini

# ---------- Agnes AI: text + image + video ----------
# Official docs: https://wiki.agnes-ai.com/llms.txt
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_AGENT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_VIDEO_TIMEOUT_MS=1200000
# Image-to-video and first/last-frame generation require PUBLIC_BASE_URL below.

# ---------- Volcengine Ark: Seedream + Seedance ----------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
ARK_TIMEOUT_MS=900000

# ---------- Kling ----------
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
KLING_VIDEO_MODEL=kling-v3
KLING_TIMEOUT_MS=900000

# ---------- Google Veo ----------
GEMINI_API_KEY=
GEMINI_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_AGENT_MODEL=gemini-2.5-flash
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=veo-3.1-generate-preview
VEO_TIMEOUT_MS=1200000

# ---------- fal (broad image + video router) ----------
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/qwen-image
FAL_VIDEO_MODEL=fal-ai/wan/v2.7/text-to-video
FAL_VIDEO_IMAGE_MODEL=fal-ai/wan/v2.7/image-to-video
FAL_TIMEOUT_MS=600000

# ---------- References / local media ----------
# If a provider requires a public URL rather than inline media, point this to a tunnel/reverse proxy for this Studio.
PUBLIC_BASE_URL=
EXTERNAL_REFERENCE_MODE=data-uri

# ---------- Media / export ----------
MAX_UPLOAD_BYTES=536870912
MAX_REMOTE_BYTES=1073741824
# Optional. Auto-detected with fontconfig when blank.
FFMPEG_FONT_FILE=
